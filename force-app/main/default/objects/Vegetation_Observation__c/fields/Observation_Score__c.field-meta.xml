<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Observation_Score__c</fullName>
    <label>Observation Score</label>
    <type>Number</type>
    <precision>5</precision>
    <scale>0</scale>
    <formula>IF(ISPICKVAL(Encroachment_Level__c, "Contact"), 40, IF(ISPICKVAL(Encroachment_Level__c, "Severe"), 30, IF(ISPICKVAL(Encroachment_Level__c, "Moderate"), 15, IF(ISPICKVAL(Encroachment_Level__c, "Minimal"), 5, 0))))</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
</CustomField>