<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Risk_Tier__c</fullName>
    <label>Risk Tier</label>
    <type>Text</type>
    <formula>IF(Total_Risk_Score__c >= 80, "Critical", IF(Total_Risk_Score__c >= 60, "High", IF(Total_Risk_Score__c >= 40, "Medium", "Low")))</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
</CustomField>