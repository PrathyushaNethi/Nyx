<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Trim_Overdue__c</fullName>
    <label>Trim Overdue</label>
    <type>Checkbox</type>
    <formula>IF(NOT(ISBLANK(Last_Trim_Date__c)), TODAY() - Last_Trim_Date__c > 365, FALSE)</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
</CustomField>