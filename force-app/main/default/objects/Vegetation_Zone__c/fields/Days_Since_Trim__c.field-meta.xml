<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Days_Since_Trim__c</fullName>
    <label>Days Since Last Trim</label>
    <type>Number</type>
    <precision>5</precision>
    <scale>0</scale>
    <formula>IF(NOT(ISBLANK(Last_Trim_Date__c)), TODAY() - Last_Trim_Date__c, NULL)</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
</CustomField>