<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Days_Since_Inspection__c</fullName>
    <label>Days Since Last Inspection</label>
    <type>Number</type>
