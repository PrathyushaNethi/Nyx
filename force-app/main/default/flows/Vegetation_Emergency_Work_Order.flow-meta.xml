<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>60.0</apiVersion>
    <label>Vegetation Emergency Work Order</label>
    <processType>AutoLaunchedFlow</processType>
    <status>Active</status>
    <description>Creates an Emergency Work Order immediately when vegetation line contact is detected</description>

    <triggerType>RecordAfterSave</triggerType>
    <object>Vegetation_Observation__c</object>
    <recordTriggerType>CreateAndUpdate</recordTriggerType>

    <recordCreates>
        <name>Create_Emergency_Work_Order</name>
        <label>Create Emergency Work Order</label>
        <locationX>176</locationX>
        <locationY>300</locationY>
        <inputAssignments>
            <field>Structure__c</field>
            <value>
                <elementReference>$Record.Structure__c</elementReference>
            </value>
        </inputAssignments>
            <inputAssignments>
            <field>Work_Type__c</field>
            <value>
                <stringValue>Trim Vegetation</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Priority__c</field>
            <value>
                <stringValue>Critical</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Status__c</field>
            <value>
                <stringValue>New</stringValue>
            </value>
        </inputAssignments>
        <object>Work_Order__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordCreates>

    <recordUpdates>
        <name>Update_Vegetation_Observation</name>
        <label>Mark Work Order Created</label>
        <locationX>176</locationX>
        <locationY>420</locationY>
        <inputAssignments>
            <field>Work_Order_Created__c</field>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </inputAssignments>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <object>Vegetation_Observation__c</object>
    </recordUpdates>

    <start>
        <locationX>56</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Create_Emergency_Work_Order</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Line_Contact__c</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Work_Order_Created__c</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <object>Vegetation_Observation__c</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>

    <transitions>
        <from>Create_Emergency_Work_Order</from>
        <to>Update_Vegetation_Observation</to>
        <doesRequireRecordChangedToMeetCriteria>false</doesRequireRecordChangedToMeetCriteria>
    </transitions>
</Flow>